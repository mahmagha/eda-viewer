similarity":0.111},{"key":"cid:31372","title":"Sodium acetate","products":11,"mw":59.0,"logp":-1.24,"tpsa":40.1,"hbd":0,"hba":2,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"C2H3O2-","similarity":0.1},{"key":"cid:23665404","title":"Sodium Acetate Trihydrate","products":9,"mw":59.0,"logp":-1.24,"tpsa":40.1,"hbd":0,"hba":2,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"C2H3O2-","similarity":0.1},{"key":"cid:11192","title":"Zinc acetate","products":6,"mw":59.0,"logp":-1.24,"tpsa":40.1,"hbd":0,"hba":2,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"C2H3O2-","similarity":0.1}]},"eml":false,"names":[["Calcium-DL-2-hydroxy-4-(Methylthio) Butyrate",5]],"atc":[],"by_type":{"human":5},"co_ingredients":[{"key":"cid:997","title":"Phenylpyruvic acid","count":6},{"key":"cid:49","title":"Α-Ketoisovaleric acid","count":6},{"key":"cid:47","title":"alpha-Keto-beta-methylvaleric acid","count":6},{"key":"cid:70","title":"Α-Ketoisocaproic acid","count":6},{"key":"cid:5962","title":"L-Lysine","count":5},{"key":"cid:6288","title":"Threonine","count":5},{"key":"cid:6305","title":"Tryptophan","count":5},{"key":"cid:6274","title":"Histidine","count":5},{"key":"cid:6057","title":"Tyrosine","count":5},{"key":"cid:11427","title":"2-Hydroxy-4-(methylthio)butyric acid","count":1}]},"cid:82148":{"key":"cid:82148","title":"Agomelatine","compound":{"key":"cid:82148","cid":82148,"qid":"Q395229","title":"Agomelatine","iupac":"N-[2-(7-methoxynaphthalen-1-yl)ethyl]acetamide","wiki_url":"https://en.wikipedia.org/wiki/Agomelatine","cas":"138112-76-2","iuphar":"198","drugbank":"DB06594","chemspider":"74141","unii":"137R1N49AD","kegg":"D02578","chebi":"134990","chembl":"CHEMBL10878","pdb_ligand":"AWY","comptox":"DTXSID3057642","echa":"100.157.896","description":"chemical compound","kind":null,"atc":"N06AX22","mesh":"C084711","uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:39+00:00","eml":null,"smiles":"CC(=O)NCCC1=CC=CC2=C1C=C(C=C2)OC","chembl_phase":4.0,"first_approval":2009,"bbw":0,"fda":0,"ema":1,"control":null,"reg_at":"2026-11-10T10:48:38+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"Agomelatine is indicated to treat major depressive episodes in adults.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Drugs used to induce drowsiness or sleep or to reduce psychological excitement or anxiety.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0010885.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Drug Classes","items":[{"section":"Drug Classes","text":"Breast Feeding; Lactation; Milk, Human; Antidepressants","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/agomelatine/","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Agomelatine resynchronises circadian rhythms in animal models of delayed sleep phase syndrome and other circadian rhythm disruptions. It increases noradrenaline and dopamine release specifically in the frontal cortex and has no influence on the extracellular levels of serotonin. Agomelatine has shown an antidepressant-like effect in animal depression models, (learned helplessness test, despair test, and chronic mild stress) circadian rhythm desynchronisation, and in stress and anxiety models. In humans, agomelatine has positive phase shifting properties; it induces a phase advance of sleep, body temperature decline and melatonin onset. Controlled studies in humans have shown that agomelatine is as effective as the SSRI antidepressants paroxetine and sertraline in the treatment of major depression","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"The novel antidepressant agent, agomelatine, behaves as an agonist at melatonin receptors (MT1 and MT2) and as an antagonist at serotonin (5-HT)(2C) receptors.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Bioavailability is less than 5%.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Protein Binding","items":[{"section":"Protein Binding","text":"> 95%","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"Hepatic (90% CYP1A2 and 10% CYP2C9).","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"<2 hours","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06594","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[{"section":"Effects During Pregnancy and Lactation","items":[{"section":"Effects During Pregnancy and Lactation","text":"◉ Summary of Use during Lactation Agomelatine is not approved for marketing in the United States by the U.S. Food and Drug Administration (FDA), but is available in other countries. Some follow-up data reported possible drowsiness and developmental concerns in one infant, but no problems in 16 other breastfed infants. A minimal amount of information indicates that exposure and adverse effects can be avoided in breastfed infants if breastfeeding is held for 4 hours after a dose. ◉ Effects in Breastfed Infants A woman with severe postpartum depression was given agomelatine 25 mg daily at bedtime. She breastfed her infant for 12 weeks, taking the dose after her last breastfeeding of the day and then pumping her milk in the morning before resuming breastfeeding. Her use of formula, if any, was not mentioned. She breastfed normally during the day. Her infant developed normally and had no abnormal laboratory values or adverse effects during the 12-week period. A prospective study followed 14 mothers taking agomelatine from birth and their 16 breastfed infants. The women were taking an average dose of 25 mg daily, with a range of 25 mg twice weekly to 50 mg daily. Infants were breastfed for an average of 7.4 months. Thirteen mothers did not report any short- or long-term adverse effects. One mother reported a possible adverse reaction of drowsiness in her baby in the first few weeks after birth which she attributed to agomelatine. She was taking agomelatine in an unspecified dose with duloxetine 90 mg daily and continued breastfeeding her baby until 9 months of age. She reported some developmental concerns of speech and low muscle tone in her baby who was 9 months of age at the time of follow-up. ◉ Effects on Lactation and Breastmilk Relevant published information was not found as of the revision date.","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/agomelatine/"}]}],"manufacturing":[],"structure":true,"populations":{},"reg":{"fda":0,"ema":1,"phase":4.0,"first_approval":2009,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":null},"chem":{"props":{"key":"cid:82148","title":"Agomelatine","products":2,"mw":243.3,"logp":2.53,"tpsa":38.3,"hbd":1,"hba":2,"rotb":4,"rings":2,"heavy":18,"lipinski":0,"formula":"C15H17NO2"},"similar":[{"key":"cid:896","title":"Melatonin","products":4,"mw":232.3,"logp":1.86,"tpsa":54.1,"hbd":2,"hba":2,"rotb":4,"rings":2,"h