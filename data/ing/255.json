ey":"cid:443980","title":"Flumetasone pivalate","products":6,"mw":494.6,"logp":3.44,"tpsa":100.9,"hbd":2,"hba":6,"rotb":3,"rings":4,"heavy":35,"lipinski":0,"formula":"C27H36F2O6","similarity":0.652},{"key":"cid:9782","title":"Betamethasone","products":73,"mw":392.5,"logp":1.9,"tpsa":94.8,"hbd":3,"hba":5,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H29FO5","similarity":0.606},{"key":"cid:5743","title":"Dexamethasone","products":115,"mw":392.5,"logp":1.9,"tpsa":94.8,"hbd":3,"hba":5,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H29FO5","similarity":0.606},{"key":"cid:6918178","title":"Ulobetasol propionate","products":1,"mw":485.0,"logp":4.05,"tpsa":80.7,"hbd":1,"hba":5,"rotb":4,"rings":4,"heavy":33,"lipinski":0,"formula":"C25H31ClF2O5","similarity":0.583},{"key":"cid:9642","title":"Fluocinonide","products":4,"mw":494.5,"logp":2.94,"tpsa":99.1,"hbd":1,"hba":7,"rotb":3,"rings":5,"heavy":35,"lipinski":0,"formula":"C26H32F2O7","similarity":0.568}]},"eml":false,"names":[["FLUOCINOLONE",3]],"atc":[],"by_type":{"human":3},"co_ingredients":[{"key":"cid:785","title":"Hydroquinone","count":1},{"key":"cid:444795","title":"Tretinoin","count":1},{"key":"cid:3676","title":"Lidocaine","count":1}]},"cid:121396":{"key":"cid:121396","title":"Carglumic acid","compound":{"key":"cid:121396","cid":121396,"qid":"Q822884","title":"Carglumic Acid","iupac":"(2S)-2-(carbamoylamino)pentanedioic acid","wiki_url":"https://en.wikipedia.org/wiki/Carglumic_acid","cas":"1188-38-1","iuphar":"7458","drugbank":"DB06775","chemspider":"108351","unii":"5L0HB4V1EW","kegg":"D07130; C05829","chebi":"71028","chembl":"CHEMBL1201780","pdb_ligand":null,"comptox":"DTXSID7046706","echa":"100.116.323","description":"chemical compound","kind":null,"atc":"A16AA05","mesh":null,"uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:39+00:00","eml":null,"smiles":"C(CC(=O)O)[C@@H](C(=O)O)NC(=O)N","chembl_phase":4.0,"first_approval":2003,"bbw":0,"fda":1,"ema":1,"control":null,"reg_at":"2026-11-10T10:48:40+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"For the treatment of acute and chronic hyperammonaemia in patients with N-acetylglutamate synthase (NAGS) deficiency. This enzyme is an important component of the urea cycle to prevent build up of neurotoxic ammonium in the blood.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Drug Indication","text":"FDA Label","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Drug Classes","items":[{"section":"Drug Classes","text":"Urea Cycle Disorder Agents","source":"LiverTox","url":"https://www.ncbi.nlm.nih.gov/books/n/livertox/CarglumicAcid/","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"The median Tmax of Carbaglu was 3 hours (range: 2-4). The daily dose of carglumic acid ranges from 100 to 250 mg/kg and this does are normally adjusted to maintain normal plasma levels of ammonia.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Carglumic acid is a synthetic structural analogue of N-acetylglutamate (NAG), which is an essential allosteric activator of the liver enzyme carbamoyl phosphate synthetase 1 (CPS1). CPS1 is found in the mitochondria and is the first enzyme of the urea cycle, which converts ammonia into urea. Carglumic acid acts as a replacement for NAG in NAGS deficiency patients by activating CPS1 but it does not help to regulate the urea cycle.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"30% bioavailability; Cmax, mean, 100 mg/kg dose = 2.6 μg/mL (range of 1.9 - 4.8)   Carglumic acid is not subject to to intracellular degradation.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"Following administration of a single radiolabeled oral dose of 100 mg/kg of body weight, 9% of the dose was excreted unchanged in the urine and up to 60% of the dose was excreted unchanged in the feces.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"The apparent volume of distribution was 2657 L (range: 1616-5797).","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"The apparent total clearance was 5.7 L/min (range 3.0-9.7), the renal clearance was 290 mL/min (range 204-445), and the 24-hour urinary excretion was 4.5 % of the dose (range 3.5-7.5).","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"A proportion of carglumic acid may be metabolized by the intestinal bacterial flora. The likely end product of carglumic acid metabolism is carbon dioxide, eliminated through the lungs.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"Median values for the terminal half-life was 5.6 hours (range 4.3-9.5).","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06775","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[{"section":"LiverTox Summary","items":[{"section":"LiverTox Summary","text":"Carglumic acid is an orphan drug and a derivative of N-acetylglutamate that activates the first enzyme in the urea cycle that is responsible for removal and detoxification of ammonia, making this drug a valuable agent for therapy of hyperammonemia caused by rare forms of urea cycle defects. Clinical experience with carglumic acid is limited, but it has not been linked to significant serum enzyme elevations during therapy or to instances of clinically apparent acute liver injury.","source":"LiverTox","url":"https://www.ncbi.nlm.nih.gov/books/n/livertox/CarglumicAcid/"}]},{"section":"Hepatotoxicity","items":[{"section":"Hepatotoxicity","text":"The urea cycle disorders include at least 8 genetic conditions, one of the more rare causes being NAGS. Because this condition is so rare, carglumic acid was given orphan disease drug status and approval was based on open labelled treatment studies of only 40 patients. In these studies, carglumic acid was not linked to serum enzyme elevations during treatment or to episodes of acute, clinically apparent liver injury or jaundice. Since approval, there have been no published reports of hepatotoxicity attributed to carglumic acid and the product label does not mention liver injury as an adverse event. Likelihood score: E (unlikely cause of clinically apparent liver injury, but experience with its use is limited).","source":"LiverTox","url":"https://www.ncbi.nlm.nih.gov/books/n/livertox/CarglumicAcid/"}]}],"manufacturing":[],"structure":true,"populations":{"child":{"label":"Suitable for children","count":2,"forms":[["Dispersible Tablet",2]]},"noswallow":{"label":"No tablet or capsule to swallow","count":2,"forms":[["Dispersible Tablet",2]]}},"reg":{"fda":1,"ema":1,"phase":4.0,"first_approval":2003,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":null},"chem