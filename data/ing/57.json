{"qid:Q23400":{"key":"qid:Q23400","title":"Garlic","compound":{"key":"qid:Q23400","cid":null,"qid":"Q23400","title":"Allium sativum","iupac":null,"wiki_url":"https://en.wikipedia.org/wiki/Garlic","cas":null,"iuphar":null,"drugbank":null,"chemspider":null,"unii":"IIF21WT8O3","kegg":null,"chebi":null,"chembl":null,"pdb_ligand":null,"comptox":null,"echa":null,"description":"species of plant (for the food, use Q21546392)","kind":"organism","atc":null,"mesh":"D005737","uniprot":null,"ncbi_taxon":"4682","gbif":"2856681","powo":"urn:lsid:ipni.org:names:528796-1","extra_at":"2026-11-08T19:10:05+00:00","eml":null,"smiles":null,"chembl_phase":null,"first_approval":null,"bbw":null,"fda":null,"ema":null,"control":null,"reg_at":null},"status":null,"pharm":[],"safety":[],"manufacturing":[],"structure":false,"populations":{},"reg":{"fda":null,"ema":null,"phase":null,"first_approval":null,"bbw":false,"control":null,"withdrawn":[],"reg_checked":false,"aware":null},"chem":null,"eml":false,"names":[["Garlic powder extract",2]],"atc":[],"by_type":{"herbal":1,"biocides":1},"co_ingredients":[{"key":"qid:Q904800","title":"Citronella oil","count":1},{"key":"qid:Q900534","title":"Lavender oil","count":1}]},"cid:65944":{"key":"cid:65944","title":"Pidotimod","compound":{"key":"cid:65944","cid":65944,"qid":"Q3902720","title":"Pidotimod","iupac":"(4R)-3-[(2S)-5-oxopyrrolidine-2-carbonyl]-1,3-thiazolidine-4-carboxylic acid","wiki_url":"https://en.wikipedia.org/wiki/Pidotimod","cas":"121808-62-6","iuphar":null,"drugbank":"DB11364","chemspider":"59348","unii":"785363R681","kegg":"D07261","chebi":"94618","chembl":"CHEMBL1488165","pdb_ligand":null,"comptox":"DTXSID0046199","echa":null,"description":"chemical compound","kind":null,"atc":"L03AX05","mesh":"C064893","uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:41+00:00","eml":null,"smiles":"C1CC(=O)N[C@@H]1C(=O)N2CSC[C@H]2C(=O)O","chembl_phase":2.0,"first_approval":null,"bbw":0,"fda":0,"ema":1,"control":null,"reg_at":"2026-11-10T10:50:38+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"For use as immunostimulant therapy for treatment of cell-mediated immunosuppression with respiratory or urinary infections.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB11364","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Substances that augment, stimulate, activate, potentiate, or modulate the immune response at either the cellular or humoral level. The classical agents (Freund&apos;s adjuvant, BCG, Corynebacterium parvum, et al.) contain bacterial antigens. Some are endogenous (e.g., histamine, interferon, transfer factor, tuftsin, interleukin-1). Their mode of action is either non-specific, resulting in increased immune responsiveness to a wide variety of antigens, or antigen-specific, i.e., affecting a restricted type of immune response to a narrow group of antigens. The therapeutic efficacy of many biological response modifiers is related to their antigen-specific immunoadjuvanticity.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0000431.html","license_url":"https://www.nlm.nih.gov/copyright.html"},{"section":"MeSH Pharmacological Classification","text":"Biologically active substances whose activities affect or play a role in the functioning of the immune system.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0011157.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Pidotimod modulates the immune system to induce an immune response against bacterial or viral pathogens","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB11364","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Pidotimod inhibits tumor necrosis factor α (TNF-α) induced increases in extracellular signal-related kinase (ERK) phosphorylation. It also increases nuclear factor κB (NFκB) expression and translocation to the nucleus. It is these to modulatory effects on ERK and NFκB signalling which are thought to produce the increase in toll-like receptor expression seen with pidotimod. Pidotimod increase maturation of dendritic cells responsible for presenting antigens to naive Th-cells. It also appears to result in a greater population these cells diiferentiating to Th1 cells which are believed to mediate the immune response to pathogens like bacteria and viruses. Lastly, pidotimod appears to increase antigen-specific antibody titer and cytotoxic response with antigen exposure. The precise mechanism and timeline of events leading to these effects is unknown.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB11364","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Bioavailability of 45%.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB11364","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"95% of intravenous dose is eliminated in the urine as the parent compound.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB11364","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"Half life of 4 h.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB11364","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[],"manufacturing":[],"structure":true,"populations":{"child":{"label":"Suitable for children","count":1,"forms":[["Granules for Oral Solution",1]]},"noswallow":{"label":"No tablet or capsul