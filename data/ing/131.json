{"cid:54766":{"key":"cid:54766","title":"Bambuterol","compound":{"key":"cid:54766","cid":54766,"qid":"Q3633651","title":"Bambuterol","iupac":"[3-[2-(tert-butylamino)-1-hydroxyethyl]-5-(dimethylcarbamoyloxy)phenyl] N,N-dimethylcarbamate","wiki_url":"https://en.wikipedia.org/wiki/Bambuterol","cas":"81732-65-2","iuphar":"6601","drugbank":"DB01408","chemspider":"49466","unii":"Y1850G1OVC","kegg":"D07377","chebi":"553827","chembl":"CHEMBL521589","pdb_ligand":null,"comptox":"DTXSID5048550","echa":null,"description":"chemical compound","kind":null,"atc":"R03CC12","mesh":"C047766","uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:30+00:00","eml":null,"smiles":"CC(C)(C)NCC(C1=CC(=CC(=C1)OC(=O)N(C)C)OC(=O)N(C)C)O","chembl_phase":3.0,"first_approval":null,"bbw":0,"fda":0,"ema":1,"control":null,"reg_at":"2026-11-10T10:44:42+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"For the prevention and reversal of bronchospasm in patients 12 years of age and older with asthma and reversible bronchospasm associated with bronchitis and emphysema.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01408","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Agents that cause an increase in the expansion of a bronchus or bronchial tubes.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0002975.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Bambuterol is a long acting beta2-adrenoceptor agonist used in the treatment of asthma. It is a prodrug of terbutaline. Bambuterol causes smooth muscle relaxation, resulting in dilation of bronchial passages.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01408","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"The pharmacologic effects of bambuterol are at least in part attributable to stimulation through beta-adrenergic receptors (beta 2 receptors) of intracellular adenyl cyclase, the enzyme that catalyzes the conversion of adenosine triphosphate (ATP) to cyclic AMP. Increased cyclic AMP levels are associated with relaxation of bronchial smooth muscle and inhibition of release of mediators of immediate hypersensitivity from cells, especially from mast cells.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01408","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Bioavailability is 20% following oral administration.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01408","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"Hepatic, extensive. Further metabolized to terbutaline by plasma cholinesterase.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01408","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"13 hours for bambuterol and 21 hours for the primary active metabolite terbutaline.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01408","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[],"manufacturing":[],"structure":true,"populations":{"child":{"label":"Suitable for children","count":2,"forms":[["Oral Syrup",1],["Oral Solution",1]]},"noswallow":{"label":"No tablet or capsule to swallow","count":2,"forms":[["Oral Syrup",1],["Oral Solution",1]]}},"reg":{"fda":0,"ema":1,"phase":3.0,"first_approval":null,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":