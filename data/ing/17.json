rity":1.0},{"key":"cid:134717","title":"Magnesium Acetate Tetrahydrate","products":2,"mw":59.0,"logp":-1.24,"tpsa":40.1,"hbd":0,"hba":2,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"C2H3O2-","similarity":1.0},{"key":"cid:517044","title":"Potassium acetate","products":2,"mw":59.0,"logp":-1.24,"tpsa":40.1,"hbd":0,"hba":2,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"C2H3O2-","similarity":1.0},{"key":"cid:10112","title":"Calcium carbonate","products":41,"mw":60.0,"logp":-2.45,"tpsa":63.2,"hbd":0,"hba":3,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"CO3-2","similarity":0.556},{"key":"cid:73415812","title":"Hydrotalcite","products":5,"mw":60.0,"logp":-2.45,"tpsa":63.2,"hbd":0,"hba":3,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"CO3-2","similarity":0.556},{"key":"cid:10340","title":"Sodium carbonate","products":11,"mw":60.0,"logp":-2.45,"tpsa":63.2,"hbd":0,"hba":3,"rotb":0,"rings":0,"heavy":4,"lipinski":0,"formula":"CO3-2","similarity":0.556}]},"eml":false,"names":[["SODIUM ACETATE",10],["sodium acetate anhydrous",1]],"atc":[],"by_type":{"human":10,"veterinary":1},"co_ingredients":[{"key":"cid:4873","title":"Potassium chloride","count":10},{"key":"cid:5234","title":"Sodium chloride","count":9},{"key":"cid:5284359","title":"Calcium chloride","count":7},{"key":"cid:5360315","title":"Magnesium chloride","count":6},{"key":"cid:5793","title":"D-Glucose","count":5},{"key":"qid:Q1786125","title":"Fish oil","count":2},{"key":"qid:Q926892","title":"Soybean oil","count":2},{"key":"qid:Q93165","title":"Olive oil","count":2},{"key":"cid:5950","title":"Alanine","count":2},{"key":"cid:6322","title":"Arginine","count":2},{"key":"cid:750","title":"Glycine","count":2},{"key":"cid:6274","title":"Histidine","count":2},{"key":"cid:6306","title":"Isoleucine","count":2},{"key":"cid:6106","title":"Leucine","count":2},{"key":"cid:6137","title":"L-Methionine","count":2},{"key":"cid:6140","title":"Phenylalanine","count":2},{"key":"cid:145742","title":"L-Proline","count":2},{"key":"cid:5951","title":"Serine","count":2},{"key":"cid:1123","title":"Taurine","count":2},{"key":"cid:6288","title":"Threonine","count":2}]},"cid:5311507":{"key":"cid:5311507","title":"Zuclopenthixol","compound":{"key":"cid:5311507","cid":5311507,"qid":"Q228143","title":"Zuclopenthixol","iupac":"2-[4-[(3Z)-3-(2-chlorothioxanthen-9-ylidene)propyl]piperazin-1-yl]ethanol","wiki_url":"https://en.wikipedia.org/wiki/Zuclopenthixol","cas":"53772-83-1","iuphar":"7559","drugbank":"DB01624","chemspider":"4470984","unii":"47ISU063SG","kegg":"D03556","chebi":"51364","chembl":"CHEMBL53904","pdb_ligand":null,"comptox":"DTXSID3048233","echa":"100.053.398","description":"chemical compound","kind":null,"atc":"N05AF05","mesh":null,"uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:39+00:00","eml":null,"smiles":"C1CN(CCN1CC/C=C\\2/C3=CC=CC=C3SC4=C2C=C(C=C4)Cl)CCO","chembl_phase":3.0,"first_approval":null,"bbw":0,"fda":0,"ema":1,"control":null,"reg_at":"2026-11-10T10:48:16+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"Used in the management of acute psychoses such as mania or schizophrenia. However, the use of zuclopenthixol acetate in psychiatric emergencies as an alternative to standard treatments (haloperidol, clotiapine, etc.) should be cautioned, since well executed and documented trials of zuclopenthixol acetate for this use have yet to be conducted. Zuclopenthixol acetate is not intended for long-term use.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Drug Indication","text":"FDA Label","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Agents that control agitated psychotic behavior, alleviate acute psychotic states, reduce psychotic symptoms, and exert a quieting effect. They are used in SCHIZOPHRENIA; senile dementia; transient psychosis following surgery; or MYOCARDIAL INFARCTION; etc. These drugs are often referred to as neuroleptics alluding to the tendency to produce neurological side effects, but not all antipsychotics are likely to produce such effects. Many of these drugs may also be effective against nausea, emesis, and pruritus.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0021770.html","license_url":"https://www.nlm.nih.gov/copyright.html"},{"section":"MeSH Pharmacological Classification","text":"Drugs that bind to but do not activate DOPAMINE RECEPTORS, thereby blocking the actions of dopamine or exogenous agonists. Many drugs used in the treatment of psychotic disorders (ANTIPSYCHOTIC AGENTS) are dopamine antagonists, although their therapeutic effects may be due to long-term adjustments of the brain rather than to the acute effects of blocking dopamine receptors. Dopamine antagonists have been used for several other clinical purposes including as ANTIEMETICS, in the treatment of Tourette syndrome, and for hiccup. Dopamine receptor blockade is associated with NEUROLEPTIC MALIGNANT SYNDROME.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0027734.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Drug Classes","items":[{"section":"Drug Classes","text":"Breast Feeding; Lactation; Milk, Human; Antipsychotic Agents; Dopamine Antagonists","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/LM860/","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Zuclopenthixol is a thioxanthene with therapeutic actions similar to the phenothiazine antipsychotics. It is an antagonist at D1 and D2 dopamine receptors.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Zuclopenthixol is a typical antipsychotic neuroleptic drug of the thioxanthene class. It mainly acts by antagonism of D1 and D2 dopamine receptors. Zuclopenthixol also has high affinity for alpha1-adrenergic and 5-HT2 receptors. It has weaker histamine H1 receptor blocking activity, and even lower affinity for muscarinic cholinergic and alpha2-adrenergic receptors.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Upon reaching the body water phase, the decanoate ester is slowly released from the oil depot, which is resultantly hydrolyzed to the active substance, zuclopenthixol. The decanoate ester provides a means of slow release since zuclopenthixol itself is a short-acting drug.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"Primarily in the feces with approximately 10% in the urine.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"20 L/kg.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"approximately 0.9 L/min.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Protein Binding","items":[{"section":"Protein Binding","text":"98-99%","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"The metabolism of zuclopenthixol is mainly by sulphoxidation, side chain N-dealkylation and glucuronic acid conjugation. The metabolites are devoid of pharmacological activity.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"20 hours (range 12-28 hours) for the tablet form, 19 days for the depot form.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01624","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[{"section":"Effects During Pregnancy and Lactation","items":[{"section":"Effects During Pregnancy and Lactation","text":"◉ Summary of Use during Lactation Zuclopenthixol is not approved for marketing in the United States, by the U.S. Food and Drug Administration, but is available in other countries. Limited information indicates that maternal oral doses of up to 50 mg daily or depot injections of 72 mg every 2 weeks produce low levels in breastmilk and no detectable short-term adverse effects in the breastfed infants. No long-term data are available. One international guideline recommends that women taking zuclopenthixol not breastfeed. However, a safety scoring system finds zuclopenthixol possible to use cautiously during breastfeeding. Until more data are available, zuclopenthixol should be used with careful infant monitoring during breastfeeding. ◉ Effects in Breastfed Infants Six women received zuclopenthixol during nursing. Five of the women were receiving 4 to 50 mg daily by mouth and one was receiving a depot injection of 72 mg every 2 weeks. Their breastfed infants ranged in age from 3 days to 10 months old, 5 of whom were 2 months or under. No immediate adverse effects such infant drowsiness were noted. ◉ Effects on Lactation and Breastmilk Relevant published information was not found as of the revision date.","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/LM860/"}]}],"manufacturing":[],"structure":true,"populations":{"noswallow":{"label":"No tablet or capsule to swallow","count":2,"forms":[["Solution for I.M Injection",2]]}},"reg":{"fda":0,"ema":1,"phase":3.0,"first_approval":null,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":null},"chem":{"props":{"key":"cid:5311507","title":"Zuclopenthixol","products":2,"mw":401.0,"logp":4.24,"tpsa":26.7,"hbd":1,"hba":4,"rotb":5,"rings":4,"heavy":27,"lipinski":0,"formula":"C22H25ClN2OS"},"similar":[{"key":"cid:6434100","title":"Flupenthixol Decanoate","products":1,"mw":588.8,"logp":8.29,"tpsa":32.8,"hbd":0,"hba":5,"rotb":14,"rings":4,"heavy":41,"lipinski":2,"formula":"C33H43F3N2O2S","similarity":0.466},{"key":"cid:4917","title":"Prochlorperazine","products":1,"mw":374.0,"logp":4.58,"tpsa":9.7,"hbd":0,"hba":4,"rotb":4,"rings":4,"heavy":25,"lipinski":0,"formula":"C20H24ClN3S","similarity":0.417},{"key":"cid:16351","title":"Clotiapine","products":1,"mw":343.9,"logp":4.13,"tpsa":18.8,"hbd":0,"hba":4,"rotb":0,"rings":4,"heavy":23,"lipinski":0,"formula":"C18H18ClN3S","similarity":0.393},{"key":"cid:5002","title":"Quetiapine","products":59,"mw":383.5,"logp":2.86,"tpsa":48.3,"hbd":1,"hba":6,"rotb":5,"rings":4,"heavy":27,"lipinski":0,"formula":"C21H25N3O2S","similarity":0.369},{"key":"cid:2726","title":"Chlorpromazine","products":3,"mw":318.9,"logp":4.89,"tpsa":6.5,"hbd":0,"hba":3,"rotb":4,"rings":3,"heavy":21,"lipinski":0,"formula":"C17H19ClN2S","similarity":0.323},{"key":"cid:3658","title":"Hydroxyzine","products":1,"mw":374.9,"logp":3.06,"tpsa":35.9,"hbd":1,"hba":4,"rotb":8,"rings":3,"heavy":26,"lipinski":0,"formula":"C21H27ClN2O2","similarity":0.312},{"key":"cid:3155","title":"Dosulepin","products":1,"mw":295.5,"logp":4.68,"tpsa":3.2,"hbd":0,"hba":2,"rotb"