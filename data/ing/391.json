2.94,"tpsa":99.1,"hbd":1,"hba":7,"rotb":3,"rings":5,"heavy":35,"lipinski":0,"formula":"C26H32F2O7","similarity":0.575},{"key":"cid:9400","title":"Dexamethasone phosphate","products":26,"mw":472.4,"logp":2.01,"tpsa":141.4,"hbd":4,"hba":6,"rotb":4,"rings":4,"heavy":32,"lipinski":0,"formula":"C22H30FO8P","similarity":0.557},{"key":"cid:444036","title":"Fluticasone propionate","products":39,"mw":500.6,"logp":4.43,"tpsa":80.7,"hbd":1,"hba":6,"rotb":4,"rings":4,"heavy":34,"lipinski":1,"formula":"C25H31F3O5S","similarity":0.556},{"key":"cid:65478","title":"Betamethasone phosphate","products":4,"mw":470.4,"logp":0.75,"tpsa":147.0,"hbd":2,"hba":8,"rotb":4,"rings":4,"heavy":32,"lipinski":0,"formula":"C22H28FO8P-2","similarity":0.55}]},"eml":false,"names":[["FLUMETHASONE PIVALATE",5],["Flumetasone pivalate",1]],"atc":[],"by_type":{"human":6},"co_ingredients":[{"key":"cid:2788","title":"Clioquinol","count":3},{"key":"cid:338","title":"Salicylic acid","count":2}]},"cid:5735":{"key":"cid:5735","title":"Zopiclone","compound":{"key":"cid:5735","cid":5735,"qid":"Q220426","title":"Zopiclone","iupac":"[6-(5-chloro-2-pyridinyl)-5-oxo-7H-pyrrolo[3,4-b]pyrazin-7-yl] 4-methylpiperazine-1-carboxylate","wiki_url":"https://en.wikipedia.org/wiki/Zopiclone","cas":"43200-80-2","iuphar":"7430","drugbank":"DB01198","chemspider":"5533","unii":"03A5ORL08Q","kegg":"D01372","chebi":"32315","chembl":"CHEMBL135400","pdb_ligand":null,"comptox":"DTXSID4041155","echa":"100.051.018","description":"chemical compound","kind":null,"atc":"N05CF01","mesh":"C515050","uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:39+00:00","eml":null,"smiles":"CN1CCN(CC1)C(=O)OC2C3=NC=CN=C3C(=O)N2C4=NC=C(C=C4)Cl","chembl_phase":4.0,"first_approval":null,"bbw":0,"fda":0,"ema":1,"control":"Class C (United Kingdom); Schedule IV (United States)","reg_at":"2026-11-10T10:49:18+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"For the short-term treatment of insomnia.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Drugs used to induce drowsiness or sleep or to reduce psychological excitement or anxiety.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0010885.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Zopiclone is a nonbenzodiazepine hypnotic from the pyrazolopyrimidine class and is indicated for the short-term treatment of insomnia. While Zopiclone is a hypnotic agent with a chemical structure unrelated to benzodiazepines, barbiturates, or other drugs with known hypnotic properties, it interacts with the gamma-aminobutyric acid-benzodiazepine (GABA<sub>B</sub>Z) receptor complex. Subunit modulation of the GABA<sub>B</sub>Z receptor chloride channel macromolecular complex is hypothesized to be responsible for some of the pharmacological properties of benzodiazepines, which include sedative, anxiolytic, muscle relaxant, and anticonvulsive effects in animal models. Zopiclone binds selectively to the brain alpha subunit of the GABA A omega-1 receptor.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Zopiclone exerts its action by binding on the benzodiazepine receptor complex and modulation of the GABA<sub>B</sub>Z receptor chloride channel macromolecular complex. Both zopiclone and benzodiazepines act indiscriminately at the benzodiazepine binding site on α1, α2, α3 and α5 GABAA containing receptors as full agonists causing an enhancement of the inhibitory actions of GABA to produce the therapeutic (hypnotic and anxiolytic) and adverse effects of zopiclone.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Rapidly absorbed following oral administration.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Protein Binding","items":[{"section":"Protein Binding","text":"Approximately 45%","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"Extensively metabolized in the liver via decarboxylation (major pathway), demethylation, and side chain oxidation. Metabolites include an N-oxide derivative (weakly active; approximately 12% of a dose) and an N-desmethyl metabolite (inactive; approximately 16%). Approximately 50% of a dose is converted to other inactive metabolites via decarboxylation. Hepatic microsomal enzymes are apparently not involved in zopiclone clearance.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Metabolism/Metabolites","text":"Extensively metabolized in the liver via decarboxylation (major pathway), demethylation, and side chain oxidation. Metabolites include an N-oxide derivative (weakly active; approximately 12% of a dose) and an N-desmethyl metabolite (inactive; approximately 16%). Approximately 50% of a dose is converted to other inactive metabolites via decarboxylation. Hepatic microsomal enzymes are apparently not involved in zopiclone clearance.\nHalf Life: Elimination half life is approximately 5 hours (range 3.8 to 6.5 hours) and is prolonged to 11.9 hours in patients with hepatic insufficiency.","source":"Toxin and Toxin Target Database (T3DB)","url":"http://www.t3db.ca/toxins/T3D3016","license_url":"https://t3db.ca/downloads"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"Elimination half life is approximately 5 hours (range 3.8 to 6.5 hours) and is prolonged to 11.9 hours in patients with hepatic insufficiency.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB01198","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[{"section":"Toxicity Summary","items":[{"section":"Toxicity Summary","text":"Zopiclone exerts its action by binding on the benzodiazepine receptor complex and modulation of the GABA<sub>B</sub>Z receptor chloride channel macromolecular complex. Both zopiclone and benzodiazepines act indiscriminately at the benzodiazepine binding site on alpha1, alpha2, alpha3 and alpha5 GABAA containing receptors as full agonists causing an enhancement of the inhibitory actions of GABA to produce the therapeutic (hypnotic and anxiolytic) and adverse effects of zopiclone.","source":"Toxin and Toxin Target Database (T3DB)","url":"http://www.t3db.ca/toxins/T3D3016"}]}],"manufacturing":[],"structure":true,"populations":{},"reg":{"fda":0,"ema":1,"phase":4.0,"first_approval":null,"bbw":false,"control":"Class C (United Kingdom); Schedule IV (United States)","withdrawn":[{"chembl":"CHEMBL135400","country":"Norway","year":1987,"class":"carcinogenicity","description":"animal studies have disclosed thyroid disorders and neoplasms","ref_url":"https://www.un.org/esa/coordination/CL12.pdf"},{"chembl":"CHEMBL135400","country":"Norway","year":1987,"class":null,"description":"animal studies have disclosed thyroid disorders and neoplasms","ref_url":"https://www.un.org/esa/coordination/CL12.pdf"}],"reg_checked":true,"aware":null},"chem":{"props":{"key":"cid:5735","title":"Zopiclone","products":2,"mw":388.8,"logp":1.57,"tpsa":91.8,"hbd":0,"hba":7,"rotb":2,"rings":4,"heavy":27,"lipinski":0,"formula":"C17H17ClN6O3"},"similar":[{"key":"cid:9694