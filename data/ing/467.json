damidopentanoyl]pyrrolidine-2-carbonyl]amino]acetyl]amino]acetyl]amino]acetyl]amino]acetyl]amino]-4-oxobutanoyl]amino]acetyl]amino]-3-carboxypropanoyl]amino]-3-phenylpropanoyl]amino]-4-carboxybutanoyl]amino]-4-carboxybutanoyl]amino]-3-methylpentanoyl]pyrrolidine-2-carbonyl]amino]-4-carboxybutanoyl]amino]-4-carboxybutanoyl]amino]-3-(4-hydroxyphenyl)propanoyl]amino]-4-methylpentanoic acid","wiki_url":"https://en.wikipedia.org/wiki/Bivalirudin","cas":"128270-60-0","iuphar":"6470","drugbank":"DB00006","chemspider":"10482069","unii":null,"kegg":"D03136","chebi":"59173","chembl":"CHEMBL2103749","pdb_ligand":null,"comptox":"DTXSID00155847","echa":null,"description":"specific and reversible direct thrombin inhibitor","kind":null,"atc":"B01AE06","mesh":"C074619","uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:41+00:00","eml":null,"smiles":"CC[C@H](C)[C@@H](C(=O)N1CCC[C@H]1C(=O)N[C@@H](CCC(=O)O)C(=O)N[C@@H](CCC(=O)O)C(=O)N[C@@H](CC2=CC=C(C=C2)O)C(=O)N[C@@H](CC(C)C)C(=O)O)NC(=O)[C@H](CCC(=O)O)NC(=O)[C@H](CCC(=O)O)NC(=O)[C@H](CC3=CC=CC=C3)NC(=O)[C@H](CC(=O)O)NC(=O)CNC(=O)[C@H](CC(=O)N)NC(=O)CNC(=O)CNC(=O)CNC(=O)CNC(=O)[C@@H]4CCCN4C(=O)[C@H](CCCNC(=N)N)NC(=O)[C@@H]5CCCN5C(=O)[C@@H](CC6=CC=CC=C6)N","chembl_phase":null,"first_approval":null,"bbw":null,"fda":1,"ema":1,"control":null,"reg_at":"2026-11-10T10:50:30+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"For treatment of heparin-induced thrombocytopenia and for the prevention of thrombosis. Bivalirudin is indicated for use in patients undergoing percutaneous coronary intervention (PCI), in patients at moderate to high risk acute coronary syndromes due to unstable angina or non-ST segment elevation in whom a PCI is planned.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Drug Indication","text":"FDA Label","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Drug Indication","text":"Bivalirudin is a direct thrombin inhibitor (DTI) with specific actions indicated for intravenous (IV) anticoagulation in patients with acute myocardial infarction, unstable angina, percutaneous coronary intervention (PCI), and thrombosis in patients with a history of heparin-induced thrombocytopenia (HIT).","source":"StatPearls","url":"https://www.ncbi.nlm.nih.gov/books/n/statpearls/article-88828/","license_url":null}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Endogenous factors and drugs that directly inhibit the action of THROMBIN, usually by blocking its enzymatic activity. They are distinguished from INDIRECT THROMBIN INHIBITORS, such as HEPARIN, which act by enhancing the inhibitory effects of antithrombins.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0544738.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Drug Classes","items":[{"section":"Drug Classes","text":"Breast Feeding; Lactation; Milk, Human; Anticoagulants; Antithrombins","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/LM1198/","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Bivalirudin mediates an inhibitory action on thrombin by directly and specifically binding to both the catalytic site and anion-binding exosite of circulating and clot-bound thrombin. The action of bivalirudin is reversible because thrombin will slowly cleave the thrombin-bivalirudin bond which recovers the active site of thrombin.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Inhibits the action of thrombin by binding both to its catalytic site and to its anion-binding exosite. Thrombin is a serine proteinase that plays a central role in the thrombotic process, acting to cleave fibrinogen into fibrin monomers and to activate Factor XIII to Factor XIIIa, allowing fibrin to develop a covalently cross-linked framework which stabilizes the thrombus; thrombin also activates Factors V and VIII, promoting further thrombin generation, and activates platelets, stimulating aggregation and granule release.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Following intravenous administration, bivalirudin exhibits linear pharmacokinetics.  The mean steady state concentration is 12.3 +/- 1.7mcg/mL after administration of an intravenous bolus of 1mg/kg followd by a 2.5mg/kg/hr intravenous infusion given over 4 hours.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"Bivalirudin is cleared from plasma by a combination of renal mechanisms (20%) and proteolytic cleavage.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"0.2L/kg","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"3.4 mL/min/kg [Normal renal function] 3.4 mL/min/kg [mild renal function] 2.7 mL/min/kg [moderate renal function] 2.8 mL/min/kg [severe renal function] 1 mL/min/kg [Dialysis-dependent patients]","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Protein Binding","items":[{"section":"Protein Binding","text":"Other than thrombin and red blood cells, bivalirudin does not bind to plasma proteins.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"80% proteolytic cleavage","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"Normal renal function: 25 min (in normal conditions) Creatinine clearance 10-29mL/min: 57min Dialysis-dependant patients: 3.5h","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB00006","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[{"section":"Effects During Pregnancy and Lactation","items":[{"section":"Effects During Pregnancy and Lactation","text":"◉ Summary of Use during Lactation No information is available on the use of bivalirudin during breastfeeding. Because the drug is absorbed orally, an alternate drug is preferred. ◉ Effects in Breastfed Infants Relevant published information was not found as of the revision date. ◉ Effects on Lactation and Breastmilk Relevant published information was not found as of the revision date.","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/LM1198/"}]},{"section":"Adverse Effects","items":[{"section":"Adverse Effects","text":"Adverse effects include the following: * The most common adverse effects include hypotension, backache, and nausea. * Major bleeding, cardiogenic shock, cardiac tamponade, and stroke are potential complications associated with using bivalirudin. * Diffuse alveolar hemorrhage has been described as a complication of bivalirudin therapy. * The use of bivalirudin in gamma brachytherapy has been linked to an elevated risk of thrombosis. Drug-Drug Interactions * The risk of bleeding increases with bivalirudin and concomitant use of warfarin, heparin, thrombolytics, or glycoprotein IIb/IIIa inhibitors. * Concomitant use of bivalirudin with apixaban, rivaroxaban, mifepristone, and dabigatran should be avoided due to the increased risk of bleeding. * IV incompatibilities exist between bivalirudin and the following drugs:* Alteplase * Amiodarone * Amphotericin B * Chlorpromazine * Dobutamine * Prochlorperazine * Reteplase * Streptokinase * Vancomycin","source":"StatPearls","url":"https://www.ncbi.nlm.nih.gov/books/n/statpearls/article-88828/"}]},{"section":"Toxicity Summary","items":[{"section":"Toxicity Summary","text":"The toxic effects related to bivalirudin administration primarily pertain to bleeding. No minimum toxic dose is listed; complications can occur at therapeutic doses. In a study by Gleason et al, the no-observed-adverse-effect level (NOAEL), administered to rats intravenously over 24 hours, was 2000 mg/kg/24 h. Bivalirudin has been used in the pediatric and infant populations, but there is not enough data to recommend dosing adjustments in pediatric patients. Approximately 1.4% to 3.8% of patients will develop significant hemorrhage. Reports exist of intracranial bleeding, retroperitoneal bleeding, and clinically overt bleeding in patients undergoing PCI to treat unstable angina. This risk increases with the concomitant use of aspirin and streptokinase. In most patients, the primary bleeding site was at the catheterization site. In the event of bleeding, evaluating the need for anticoagulation and deciding to reduce or discontinue the infusion requires clinical judgment. Appropriate monitoring includes a CBC, prothrombin time (PT), aPTT, and international normalized ratio (INR). Note that there may be variable responses with these values. Since bivalirudin excretion is primarily via the kidneys, the patient's renal function requires monitoring. Supportive care is recommended, including a fluid bolus and transfusion of platelets or packed red blood cells in thrombocytopenic/anemic patients. In patients with continued bleeding, fresh frozen plasma, prothrombin complex concentrations, and cryoprecipitate may merit consideration. Note that this comes with an inherent risk of developing thromboembolic events. There is no reversal agent available for bivalirudin.","source":"StatPearls","url":"https://www.ncbi.nlm.nih.gov/books/n/statpearls/article-88828/"}]}],"manufacturing":[],"structure":true,"populations":{"noswallow":{"label":"No tablet or capsule to swallow","count":1,"forms":[["Powder for reconstitution for IV injection/ infusion",1]]}},"reg":{"fda":1,"ema":1,"phase":null,"first_approval":null,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":null},"chem":{"props":{"key":"cid:16129704","title":"Bivalirudin","products":1,"mw":2180.3,"logp":-8.12,"tpsa":901.6,"hbd":28,"hba":29,"rotb":66,"rings":6,"heavy":155,"lipinski":3,"formula":"C98H138N24O33"},"similar":[{"key":"cid:16132438","title":"Insulin lispro","products":7,"mw":3430.0,"logp":-9.54,"tpsa":1305.6,"hbd":47,"hba":46,"rotb":107,"rings":8,"heavy":242,"lipinski":3,"formula":"C158H234N40O42S2","similarity":0.578},{"key":"cid:90472060","title":"Lixisenatide","products":2,"mw":4858.6,"logp":-22.91,"tpsa":2060.2,"hbd":70,"hba":71,"rotb":169,"rings":8,"heavy":342,"lipinski":3,"formula":"C215H347N61O65S","similarity":0.503},{"key":"cid:16129617","title":"Cosyntropin","products":2,"mw":2933.5,"logp":-7.96,"tpsa":1158.7,"hbd":42,"hba":39,"rotb":93,"rings":9,"heavy":208,"lipinski":3,"formula":"C136H210N40O31S","similarity":0.494},{"key":"cid:16132418","title":"Insulin aspart","products":7,"mw":3448.0,"logp":-10.57,"tpsa":1351.7,"hbd":49,"hba":47,"rotb":110,"rings":7,"heavy":243,"lipinski":3,"formula":"C157H232N40O44S2","similarity":0.477},{"key":"cid:166567236","title":"CID 166567236","products":18,"mw":4813.5,"logp":-12