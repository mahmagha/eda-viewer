,"heavy":34,"lipinski":3,"formula":"C18H32O16","similarity":0.451},{"key":"cid:84571","title":"alpha-D-lactose","products":3,"mw":342.3,"logp":-5.4,"tpsa":189.5,"hbd":8,"hba":11,"rotb":4,"rings":2,"heavy":23,"lipinski":2,"formula":"C12H22O11","similarity":0.451},{"key":"cid:6134","title":"Lactose","products":1,"mw":342.3,"logp":-5.4,"tpsa":189.5,"hbd":8,"hba":11,"rotb":4,"rings":2,"heavy":23,"lipinski":2,"formula":"C12H22O11","similarity":0.451},{"key":"cid:165580","title":"Paromomycin","products":4,"mw":615.6,"logp":-8.86,"tpsa":347.3,"hbd":13,"hba":19,"rotb":9,"rings":4,"heavy":42,"lipinski":3,"formula":"C23H45N5O14","similarity":0.443},{"key":"cid:8378","title":"Neomycin","products":207,"mw":614.7,"logp":-8.9,"tpsa":353.1,"hbd":13,"hba":19,"rotb":9,"rings":4,"heavy":42,"lipinski":3,"formula":"C23H46N6O13","similarity":0.426},{"key":"cid:6032","title":"Kanamycin A","products":22,"mw":484.5,"logp":-7.29,"tpsa":282.6,"hbd":11,"hba":15,"rotb":6,"rings":3,"heavy":33,"lipinski":2,"formula":"C18H36N4O11","similarity":0.349},{"key":"cid:772","title":"Heparin Sodium","products":7,"mw":1134.9,"logp":-10.71,"tpsa":610.5,"hbd":15,"hba":30,"rotb":21,"rings":4,"heavy":70,"lipinski":3,"formula":"C26H42N2O37S5","similarity":0.341}]},"eml":false,"names":[["CHITOSAN",3]],"atc":[],"by_type":{"herbal":3},"co_ingredients":[{"key":"cid:54670067","title":"Vitamin C","count":2},{"key":"cid:441476","title":"Pectin","count":2},{"key":"qid:Q2725835","title":"Gymnema sylvestre","count":2},{"key":"cid:181572","title":"Psyllic acid","count":1},{"key":"qid:Q421167","title":"Gum karaya","count":1},{"key":"cid:151932","title":"Chromium(III) picolinate","count":1}]},"cid:6450551":{"key":"cid:6450551","title":"Axitinib","compound":{"key":"cid:6450551","cid":6450551,"qid":"Q4830631","title":"Axitinib","iupac":"N-methyl-2-[[3-[(E)-2-pyridin-2-ylethenyl]-1H-indazol-6-yl]sulfanyl]benzamide","wiki_url":"https://en.wikipedia.org/wiki/Axitinib","cas":"319460-85-0","iuphar":"5659","drugbank":"DB06626","chemspider":"4953153","unii":"C9LVQ0YUXG","kegg":"D03218","chebi":"66910","chembl":"CHEMBL1289926","pdb_ligand":"AXI","comptox":"DTXSID3049049","echa":"100.166.384","description":"chemical compound","kind":null,"atc":"L01XE17","mesh":"D000077784","uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:39+00:00","eml":null,"smiles":"CNC(=O)C1=CC=CC=C1SC2=CC3=C(C=C2)C(=NN3)/C=C/C4=CC=CC=N4","chembl_phase":4.0,"first_approval":2012,"bbw":0,"fda":1,"ema":1,"control":null,"reg_at":"2026-11-10T10:49:36+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"Used in kidney cell cancer and investigated for use/treatment in pancreatic and thyroid cancer.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Drug Indication","text":"FDA Label","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"MeSH Pharmacological Classification","items":[{"section":"MeSH Pharmacological Classification","text":"Substances that inhibit or prevent the proliferation of NEOPLASMS.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0001483.html","license_url":"https://www.nlm.nih.gov/copyright.html"},{"section":"MeSH Pharmacological Classification","text":"Agents that inhibit PROTEIN KINASES.","source":"Medical Subject Headings (MeSH)","url":"https://id.nlm.nih.gov/mesh/M0457532.html","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Drug Classes","items":[{"section":"Drug Classes","text":"Breast Feeding; Lactation; Milk, Human; Antineoplastic Agents; Enzyme Inhibitors; Protein Kinase Inhibitors; Signal Transduction Inhibitors; Tyrosine Kinase Inhibitors","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/LM1261/","license_url":"https://www.nlm.nih.gov/copyright.html"},{"section":"Drug Classes","text":"Antineoplastic Agents","source":"LiverTox","url":"https://www.ncbi.nlm.nih.gov/books/n/livertox/Axitinib/","license_url":"https://www.nlm.nih.gov/copyright.html"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Axitinib prevents the progression of cancer by inhibiting angiogenesis and blocking tumor growth.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Axitinib selectively blocks the tyrosine kinase receptors VEGFR-1 (vascular endothelial growth factor receptor), VEGFR-2, and VEGFR-3.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"After one 5 mg dose of axitinib, it takes about 2.5 to 4.1 hours to reach maximum plasma concentration.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"Axitinib is mainly eliminated unchanged in the feces (41%) with 12% of the original dose as unchanged axitinib. There is also 23% eliminated in the urine, most of which are metabolites.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"The volume of distribution is 160 L.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"The average clearance of axitinib is 38 L/h.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Protein Binding","items":[{"section":"Protein Binding","text":"Plasma protein binding for axitinib is high at over 99% with most protein binding to albumin followed by α1-acid glycoprotein.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"Axitinib undergoes mainly hepatic metabolism. CYP3A4 and CYP3A5 are the main hepatic enzymes while CYP1A2, CYP2C19, and UGT1A1 enzymes are secondary.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"Axitinib has a half life of 2.5 to 6.1 hours.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB06626","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[{"section":"LiverTox Summary","items":[{"section":"LiverTox Summary","text":"Axitinib is an oral tyrosine kinase inhibitor selective for vascular endothelial growth factor (VEGF) receptors -1, -2 and -3 that is used in the therapy of advanced renal cell carcinoma. Axitinib therapy by itself is commonly associated with transient elevations in serum aminotransferase levels that are generally mild and asymptomatic and has been linked to rare instances of clinically apparent liver injury. When combined with an immune checkpoint inhibitor, as is now common, liver test abnormalities are considerably more frequent and more severe.","source":"LiverTox","url":"https://www.ncbi.nlm.nih.gov/books/n/livertox/Axitinib/"}]},{"section":"Hepatotoxicity","items":[{"section":"Hepatotoxicity","text":"In large clinical trials of axitinib, elevations in serum aminotransferase levels were common, occurring in up to 22% of patients. Values greater than 5 times the upper limit of normal (ULN), however, were uncommon, occurring in 1% to 2% of recipients. Furthermore, no instances of clinically apparent liver injury from axitinib were reported in prelicensure studies. Nevertheless, periodic monitoring of liver tests during axitinib therapy was recommended. Rates of liver test abnormalities were higher when axitinib was combined with an immune check point inhibitor than when given alone. In randomized trials in support of combination therapy of axitinib with avelumab or pembrolizumab, ALT elevations arose in 50% to 60% of patients and were above 5 times ULN in 9% to 20%. Furthermore, liver injury led to permanent discontinuation of one or both agents in 6% to 7%. Importantly, when the two drugs were restarted separately after the enzyme elevations resolved, recurrence was more common with axitinib alone [24% to 37%] than with the check point inhibitor [16%]. Among 92 patients rechallenged after the axitinib-avelumab vs axitinib-pembrolizumab combination, ALT elevations recurred in 33% vs 44% given both, 24% and 47% given axitinib alone, but in only 16% (1 of 6) given the check point inhibitor alone. These findings suggest that the check point inhibitor may increase the risk of axitinib hepatotoxicity and that therapy with the monoclonal antibody alone might be continued. Since approval of the combination of axitinib with pembrolizumab or avelumab, several case reports of liver injury attributed to axitinib have been published. Injury generally arose after 2 to 6 months of treatment and both hepatocellular and cholestatic patterns of injury occurred. Most cases resolved once the two agents were withdrawn and rechallenge with one or the other individually may demonstrate which is the major culprit. Likelihood score: C (probable uncommon cause of clinically apparent liver injury, most often when combined with an immune checkpoint inhibitor).","source":"LiverTox","url":"https://www.ncbi.nlm.nih.gov/books/n/livertox/Axitinib/"}]},{"section":"Effects During Pregnancy and Lactation","items":[{"section":"Effects During Pregnancy and Lactation","text":"◉ Summary of Use during Lactation No information is available on the use of axitinib during breastfeeding. Because axitinib is more than 99% bound to plasma proteins, the amount in milk is likely to be low. The manufacturer recommends that breastfeeding be discontinued during axitinib therapy and for 2 weeks after the final dose of therapy. When axitinib is used in combination with avelumab or pembrolizumab, refer to those LactMed records. ◉ Effects in Breastfed Infants Relevant published information was not found as of the revision date. ◉ Effects on Lactation and Breastmilk Relevant published information was not found as of the revision date.","source":"Drugs and Lactation Database (LactMed)","url":"https://www.ncbi.nlm.nih.gov/books/n/lactmed/LM1261/"}]}],"manufacturing":[],"structure":true,"populations":{},"reg":{"fda":1,"ema":1,"phase":4.0,"first_approval":2012,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":null},"chem":{"props":{"key":"cid:6450551","title":"Axitinib","products":2,"mw":386.5,"logp":4.64,"tpsa":70.7,"hbd":2,"hba":4,"rotb":5,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H18N4OS"},"similar":[{"key":"cid:3334","title":"Fenbendazole","products":34,"mw":299.4,"logp":3.89,"tpsa":67.0,"hbd":2,"hba":4,"rotb":3,"rings":3,"heavy":21,"lipinski":0,"formula":"C15H13N3O2S","similarity":0.274},{"key":"cid:151932","title":"Chromium(III) picolinate","products":8,"mw":122.1,"logp":-0.55,"tpsa":53.0,"hbd":0,"hba":3,"rotb":1,"rings":1,"heavy":9,"lipinski":0,"formula":"C6H4NO2-","similarity":0.237},{"key":"cid:44480399","title":"Fruquintinib","products":2,"mw":393.4,"logp":3.85,"tpsa":95.7,"hbd":1,"hba":7,"rotb":5,"rings":4,"heavy":29,"lipinski":0,"formula":"C21H19N3O5","similarity":0.209},{"key":"cid:16684434","title":"Thiomersal","products":3,"mw":381.8,"logp":1.58,"tpsa":40.1,"hbd":0,"hba":3,"rotb":4,"rings":1,"heavy":13,"lipinski":0,"formula":"C9H9HgO2S-","similarity":0.209},{"key":"cid:135449328","title":"Febantel","products":17,"mw":446.5,"logp":3.12,"tpsa":127.4,"hbd":3,"hba":8,"rotb":6,"rings":2,"heavy":31,"lipinski":0,"formula":"C20H22N4O6S","similarity":0.207},{"key":"cid:2366","title":"Betahistine","products":24,"mw":136.2,"logp":0.84,"tpsa":24.9,"hbd":1,"hba":2,"rotb":3,"rings":1,"heavy":10,"lipinski":0,"formula":"C8H12N2","similarity":0.206},{"key":"cid:54676228","title":"Piroxicam","products":30,"mw":331.4,"logp":1.58,"tpsa":99.6,"hbd":2,"hba":5,"rotb":2,"rings":3,"heavy":23,"lipinski":0,"formula":"C15H13N3O4S","similarity":0.205},{"key":"cid:2082","title":"Albendazole","products":110,"mw":265.3,"logp":3.24,"tpsa":67.0,"hbd":2,"hba":4,"rotb":4,"rings":2,"heavy":18,"lipinski":0,"formula":"C12H15N3O2S","similarity":0.205}]},"eml":false,"names":[["AXITINIB",2]],"atc":[{"code":"L01XE17","path":[{"code":"L","label":"Antineoplastic and immunomodulating agents"},{"code":"L01","label":"Antineoplastic"},{"code":"L01X","label":null},{"code":"L01XE","label":"ALK inhibitor"},{"code":"L01XE17","label":null}]}],"by_type":{"human":2},"co_ingredients":[]},"cid:71387":{"key":"cid:71387","title":"Clobetasone","compound":{"key":"cid:71387","cid":71387,"qid":"Q5134764","title":"Clobetasone","iupac":"(8S,9R,10S,13S,14S,16S,17R)-17-(2-chloroacetyl)-9-fluoro-17-hydroxy-10,13,16-trimethyl-7,8,12,14,15,16-hexahydro-6H-cyclopenta[a]phenanthrene-3,11-dione","wiki_url":"https://en.wikipedia.org/wiki/Clobetasone","cas":"54063-32-0","iuphar":"9088","drugbank":"DB13158","chemspider":"64482","unii":"LT69WY1J6D","kegg":"D07717","chebi":"177795","chembl":null,"pdb_ligand":null,"comptox":"DTXSID601023875","echa":"100.053.576","description":"chemical compound","kind":null,"atc":"D07AB01; S01BA09","mesh":null,"uniprot":null,"ncbi_taxon":null,"gbif":null,"powo":null,"extra_at":"2026-11-08T19:46:41+00:00","eml":null,"smiles":"C[C@H]1C[C@H]2[C@@H]3CCC4=CC(=O)C=C[C@@]4([C@]3(C(=O)C[C@@]2([C@]1(C(=O)CCl)O)C)F)C","chembl_phase":null,"first_approval":null,"bbw":null,"fda":0,"ema":0,"control":null,"reg_at":"2026-11-10T10:50:08+00:00"},"status":null,"pharm":[{"section":"Drug Indication","items":[{"section":"Drug Indication","text":"In dermatology, topical clobestasone butyrate helps to reduce the itchiness and erythema associated with eczema and dermatitis. In ophthalmology, clobetasone butyrate 0.1% eye drops have been shown to be safe and effective in the treatment of dry eyes in Sjögren's Syndrome.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Pharmacodynamics","items":[{"section":"Pharmacodynamics","text":"Topical corticosteroid like clobetasone are synthetic derivatives of cortisone which produce anti-inflammatory, antiproliferative, immunosuppressive and vasoconstrictor effects when applied to the skin.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Mechanism of Action","items":[{"section":"Mechanism of Action","text":"Topically applied clobeyasone are thought to bind with cytoplasmic receptors in the dermal and intradermal cells and to induce inhibitory proteins, thus leading to decreased activity of prostaglandins, kinins, histamine, liposomal enzymes and other endogenous mediators of inflammation. Topical corticosteroids inhibit the migration of macrophages and leukocytes into areas of inflamed skin by reversing vascular dilation and permeability, resulting in decreased erythema, edema and pruritus.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Absorption, Distribution and Excretion","items":[{"section":"Absorption, Distribution and Excretion","text":"Absorption is dependent on many drug-related factors including: intrinsic properties of the steroid itself; concentration of the drug (increased concentration generally leads to more drug being absorbed but may plateau at higher concentrations); vehicle used (optimized or augmented vehicles > ointments or gels > creams or lotions); duration of exposure; frequency of application; combination with other products that break down the skin barrier and increase absorption (e.g., salicylic acid, urea). Patient-related factors that influence absorption include: patient age (infants and children absorb topical medications more quickly and to a greater degree than adults, and have a greater total skin surface to body weight ratio; the elderly have thinner skin and absorb drug more readily); disruption of the skin due to inflammation or disease (e.g., absorption increased in atopic dermatitis); total skin area treated; skin site treated (absorption is much greater from thin-skinned areas such as scalp, face, eyelid, axilla, and scrotum than from areas with thicker skin such as forearm, knee, elbow, palm and sole); absorption is increased with increased temperature or humidity of the skin or the environment; occlusion of the treated skin (via plastic wrap, oily vehicles, dressings, tape, diapers, tight-fitting clothing, etc.) can increase absorption up to 10-fold.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"Clobetasone and its metabolites are excreted in urine.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"},{"section":"Absorption, Distribution and Excretion","text":"The use of pharmacodynamic endpoints for assessing the systemic exposure of  topical corticosteroids is necessary due to the fact that circulating levels are well below the level of detection.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Metabolism/Metabolites","items":[{"section":"Metabolism/Metabolites","text":"Once absorbed through the skin, topical corticosteroids are handled through  pharmacokinetic pathways similar to systemically administered corticosteroids. They  are metabolised, primarily in the liver.","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]},{"section":"Biological Half-Life","items":[{"section":"Biological Half-Life","text":"N/A","source":"DrugBank","url":"https://go.drugbank.com/drugs/DB13158","license_url":"https://www.drugbank.ca/legal/terms_of_use"}]}],"safety":[],"manufacturing":[],"structure":true,"populations":{},"reg":{"fda":0,"ema":0,"phase":null,"first_approval":null,"bbw":false,"control":null,"withdrawn":[],"reg_checked":true,"aware":null},"chem":{"props":{"key":"cid:71387","title":"Clobetasone","products":1,"mw":408.9,"logp":3.35,"tpsa":71.4,"hbd":1,"hba":4,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H26ClFO4"},"similar":[{"key":"cid:5311051","title":"Clobetasol","products":5,"mw":410.9,"logp":3.14,"tpsa":74.6,"hbd":2,"hba":4,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H28ClFO4","similarity":0.758},{"key":"cid:71386","title":"Clobetasone butyrate","products":1,"mw":479.0,"logp":4.7,"tpsa":77.5,"hbd":0,"hba":5,"rotb":5,"rings":4,"heavy":33,"lipinski":0,"formula":"C26H32ClFO5","similarity":0.696},{"key":"cid:441335","title":"Mometasone","products":2,"mw":427.4,"logp":3.41,"tpsa":74.6,"hbd":2,"hba":4,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H28Cl2O4","similarity":0.688},{"key":"cid:9782","title":"Betamethasone","products":73,"mw":392.5,"logp":1.9,"tpsa":94.8,"hbd":3,"hba":5,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H29FO5","similarity":0.636},{"key":"cid:5743","title":"Dexamethasone","products":115,"mw":392.5,"logp":1.9,"tpsa":94.8,"hbd":3,"hba":5,"rotb":2,"rings":4,"heavy":28,"lipinski":0,"formula":"C22H29FO5","similarity":0.636},{"key":"cid:236702","title":"Dexame